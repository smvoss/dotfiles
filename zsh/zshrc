# KMM credential proxy — per-session unique socket
ssh() {
    case "$1" in kmm-*|kmx-*|hardy-*)
        command ssh -R "/home/$(whoami)/.cred-proxy-$$.sock:127.0.0.1:9999" "$@" ;;
    *) command ssh "$@" ;;
    esac
}
